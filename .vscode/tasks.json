{
  // Run from the repo root; each task wraps a script under source/scripts or source/__assets/<platform>.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/source/ExifGlass.slnx", "-c", "Debug", "-p:Platform=x64"],
      "osx": { "args": ["build", "${workspaceFolder}/source/ExifGlass.slnx", "-c", "Debug", "-p:Platform=ARM64"] },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/source/scripts/test.ps1"],
      "osx": { "command": "bash", "args": ["${workspaceFolder}/source/scripts/test.sh"] },
      "linux": { "command": "bash", "args": ["${workspaceFolder}/source/scripts/test.sh"] },
      "problemMatcher": "$msCompile",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "selftest",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/source/scripts/selftest.ps1"],
      "osx": { "command": "bash", "args": ["${workspaceFolder}/source/scripts/selftest.sh"] },
      "linux": { "command": "bash", "args": ["${workspaceFolder}/source/scripts/selftest.sh"] },
      "problemMatcher": [],
      "group": "test"
    },


    // NativeAOT can't cross-compile between operating systems: publish each head on its own OS.
    {
      "label": "publish-aot-win-x64",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/source/scripts/publish-aot.ps1", "win-x64"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish-aot-win-arm64",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/source/scripts/publish-aot.ps1", "win-arm64"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish-aot-mac-arm64",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/source/scripts/publish-aot.sh", "osx-arm64"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish-aot-linux-x64",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/source/scripts/publish-aot.sh", "linux-x64"],
      "problemMatcher": "$msCompile",
      "dependsOn": ["build-exiftool-linux-x64"],
      "dependsOrder": "sequence",
      "group": "build"
    },


    // ExifTool for Linux: one PAR-packed binary so the app needs no system Perl; cached per RID.
    {
      "label": "build-exiftool-linux-x64",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/source/__assets/linux/build-exiftool.sh", "x64"],
      "problemMatcher": [],
      "group": "build"
    },


    // Packing scripts carried over from v2; they publish the same head projects.
    {
      "label": "pack-mac-arm64-app",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/source/__assets/mac/pack-app.sh"],
      "problemMatcher": [],
      "dependsOn": ["publish-aot-mac-arm64"],
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "pack-mac-arm64-dmg",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/source/__assets/mac/pack-dmg.sh"],
      "problemMatcher": [],
      "dependsOn": ["pack-mac-arm64-app"],
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "pack-linux-x64-flatpak",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/source/__assets/linux/pack-flatpak.sh"],
      "options": { "env": { "GPG_KEY": "${input:gpgKey}" } },
      "problemMatcher": [],
      "dependsOn": ["build-exiftool-linux-x64"],
      "dependsOrder": "sequence",
      "group": "build"
    },
    {
      "label": "pack-win-x64-msix",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/source/__assets/win/pack-msix.ps1", "-Platform", "x64", "-Sign"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "pack-win-arm64-msix",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/source/__assets/win/pack-msix.ps1", "-Platform", "arm64", "-Sign"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "pack-win-msstore-msixbundle",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/source/__assets/win/pack-msix.ps1", "-MsStore"],
      "problemMatcher": [],
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "gpgKey",
      "type": "promptString",
      "description": "GPG key (email or key ID) to sign the .flatpak bundle. Leave blank for an unsigned bundle.",
      "default": ""
    }
  ]
}
