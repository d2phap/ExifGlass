<Project>
  <!-- Libraries and tests carry the plain version -->
  <PropertyGroup Condition="'$(ExifGlassPlatformId)' == ''">
    <Version>$(ExifGlassVersion)</Version>
    <AssemblyVersion>$(ExifGlassVersion)</AssemblyVersion>
    <FileVersion>$(ExifGlassVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>


  <!-- App heads: Version-ReleaseType-Platform-Arch, baked into AppBuildInfo.g.cs as constants (AOT-safe) -->
  <PropertyGroup Condition="'$(ExifGlassPlatformId)' != ''">
    <ExifGlassFullVersion Condition="'$(ExifGlassReleaseType)' != ''">$(ExifGlassVersion)-$(ExifGlassReleaseType)-$(ExifGlassPlatformId)-$(ExifGlassArch)</ExifGlassFullVersion>
    <ExifGlassFullVersion Condition="'$(ExifGlassReleaseType)' == ''">$(ExifGlassVersion)-$(ExifGlassPlatformId)-$(ExifGlassArch)</ExifGlassFullVersion>
    <Version>$(ExifGlassFullVersion)</Version>
    <AssemblyVersion>$(ExifGlassVersion)</AssemblyVersion>
    <FileVersion>$(ExifGlassVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>


  <!-- Inline task: writes the C# source without XML-escaped code -->
  <UsingTask TaskName="_EgGenerateBuildInfo"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputPath ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <FullVersion ParameterType="System.String" Required="true" />
      <ReleaseType ParameterType="System.String" Required="false" />
      <Channel ParameterType="System.String" Required="true" />
      <PlatformId ParameterType="System.String" Required="true" />
      <Architecture ParameterType="System.String" Required="true" />
      <BuildDate ParameterType="System.String" Required="true" />
      <Copyright ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
      <![CDATA[
var code = $$"""
    // <auto-generated/>
    using ExifGlass.Core.Common;
    namespace ExifGlass;

    internal sealed class AppBuildInfo : IAppBuildInfo
    {
        public string Version { get; } = "{{Version}}";
        public string FullVersion { get; } = "{{FullVersion}}";
        public string ReleaseType { get; } = "{{ReleaseType}}";
        public string Channel { get; } = "{{Channel}}";
        public string PlatformId { get; } = "{{PlatformId}}";
        public string Architecture { get; } = "{{Architecture}}";
        public string BuildDate { get; } = "{{BuildDate}}";
        public string Copyright { get; } = "{{Copyright}}";
    }
    """;

var dir = System.IO.Path.GetDirectoryName(OutputPath);
if (!string.IsNullOrEmpty(dir))
    System.IO.Directory.CreateDirectory(dir);

if (!System.IO.File.Exists(OutputPath) || System.IO.File.ReadAllText(OutputPath) != code)
    System.IO.File.WriteAllText(OutputPath, code);
]]></Code>
    </Task>
  </UsingTask>


  <Target Name="EgGenerateAppBuildInfo"
          BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareForBuild"
          Condition="'$(ExifGlassPlatformId)' != ''">
    <PropertyGroup>
      <_EgBuildInfoFile>$(IntermediateOutputPath)AppBuildInfo.g.cs</_EgBuildInfoFile>
    </PropertyGroup>
    <_EgGenerateBuildInfo
        OutputPath="$(_EgBuildInfoFile)"
        Version="$(ExifGlassVersion)"
        FullVersion="$(ExifGlassFullVersion)"
        ReleaseType="$(ExifGlassReleaseType)"
        Channel="$(ExifGlassChannel)"
        PlatformId="$(ExifGlassPlatformId)"
        Architecture="$(ExifGlassArch)"
        BuildDate="$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd'))"
        Copyright="$(Copyright.Replace('Copyright ', ''))" />
    <ItemGroup>
      <Compile Remove="$(_EgBuildInfoFile)" />
      <Compile Include="$(_EgBuildInfoFile)" />
    </ItemGroup>
  </Target>


  <!-- Single-warn only the reviewed third-party assemblies; everything else keeps detailed warnings as errors -->
  <Target Name="EgSingleWarnThirdParty" BeforeTargets="_ComputeIlcCompileInputs;PrepareForILLink" Condition="'$(ExifGlassSingleWarnAssemblies)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy(';$(ExifGlassSingleWarnAssemblies);').Contains(';%(ResolvedFileToPublish.Filename);'))">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>


  <!-- ExifTool next to each app head: official releases dropped into __assets/exiftool; a clone without them still builds -->
  <PropertyGroup Condition="'$(ExifGlassPlatformId)' != ''">
    <ExifToolDir>$(MSBuildThisFileDirectory)__assets\exiftool\</ExifToolDir>
    <ExifToolRid Condition="'$(ExifToolRid)' == ''">$(RuntimeIdentifier)</ExifToolRid>
    <ExifToolRid Condition="'$(ExifToolRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</ExifToolRid>
    <ExifToolParBinary>$(ExifToolDir)unix\build\$(ExifToolRid)\exiftool</ExifToolParBinary>
  </PropertyGroup>

  <ItemGroup Condition="'$(ExifGlassPlatformId)' != ''">
    <None Include="$(ExifToolDir)LICENSE" Condition="Exists('$(ExifToolDir)LICENSE')" Link="exiftool.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- ExifGlass's own config, passed with -config as the daemon's first argument (S5, S9) -->
    <None Include="$(ExifToolDir)exifglass.config" Link="exifglass.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExifGlassPlatformId)' == 'win'">
    <None Include="$(ExifToolDir)win\exiftool.exe" Condition="Exists('$(ExifToolDir)win\exiftool.exe')" Link="exiftool.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExifToolDir)win\exiftool_files\**\*" Link="exiftool_files\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Linux prefers the PAR-packed binary (no system Perl needed) built by build-exiftool.sh -->
  <ItemGroup Condition="'$(ExifGlassPlatformId)' == 'linux'">
    <None Include="$(ExifToolParBinary)" Condition="Exists('$(ExifToolParBinary)')" Link="exiftool" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExifToolDir)unix\exiftool" Condition="!Exists('$(ExifToolParBinary)') And Exists('$(ExifToolDir)unix\exiftool')" Link="exiftool" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExifToolDir)unix\lib\**\*" Condition="!Exists('$(ExifToolParBinary)') And Exists('$(ExifToolDir)unix\exiftool')" Link="lib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- macOS runs the Perl script on the system Perl: a PAR binary can't be codesigned or notarized -->
  <ItemGroup Condition="'$(ExifGlassPlatformId)' == 'mac'">
    <None Include="$(ExifToolDir)unix\exiftool" Condition="Exists('$(ExifToolDir)unix\exiftool')" Link="exiftool" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ExifToolDir)unix\lib\**\*" Condition="Exists('$(ExifToolDir)unix\exiftool')" Link="lib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
