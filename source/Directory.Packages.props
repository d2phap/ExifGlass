<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- SkiaSharp arrives through Avalonia.Skia, so only a transitive pin can raise it to 4.x -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia packages move together -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.HarfBuzz" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="ProDataGrid" Version="12.1.0.6" />

    <!-- Skia fails hard on a managed/native mismatch, and the Linux assets aren't a SkiaSharp dependency: pin all four together -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />

    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="ImageGlass.SDK" Version="1.2.0" />
    <PackageVersion Include="ImageGlass.Tools" Version="1.9200.2" />

    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- 3.2.x is what Avalonia.Headless.XUnit 12.1.4 is built against -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- 0.16 preview: 0.15.x can't identify the .NET 11 runtime -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>
</Project>
