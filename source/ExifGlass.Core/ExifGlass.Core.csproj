<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>ExifGlass.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools/gen-tagdb.cs from the bundled ExifTool (S5); ".br" would otherwise read as the Breton culture -->
    <EmbeddedResource Include="Metadata\TagDb.bin.br" LogicalName="ExifGlass.Core.TagDb.bin.br" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExifGlass.Core.Tests" />
    <InternalsVisibleTo Include="ExifGlass.Benchmarks" />
  </ItemGroup>
</Project>
