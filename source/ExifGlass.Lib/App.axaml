<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ExifGlass.App"
             Name="ExifGlass"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ExifGlass.UI/Tokens/Tokens.axaml" />
        <ResourceInclude Source="avares://ExifGlass.UI/Themes/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!--  Safety net only (O14): every control the app shows gets an ExifGlass ControlTheme from Themes/Controls.axaml  -->
    <SimpleTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.v2.xaml" />
    <StyleInclude Source="avares://ExifGlass.UI/Themes/DataGrid.axaml" />
  </Application.Styles>

</Application>
