<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>ExifGlass</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExifGlass.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--  About's third-party notices (__assets/notices/gen-notices.py)  -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="ProDataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- No ImageGlass IPC in the sandboxed Mac App Store build (EG_MAS) -->
    <PackageReference Include="ImageGlass.SDK" Condition="'$(ExifGlassChannel)' != 'MacAppStore'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExifGlass.Core\ExifGlass.Core.csproj" />
    <ProjectReference Include="..\ExifGlass.UI\ExifGlass.UI.csproj" />
  </ItemGroup>
</Project>
