<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ExifGlass.UI.Controls"
             xmlns:vm="using:ExifGlass.ViewModels"
             x:Class="ExifGlass.Views.CommandBar"
             x:DataType="vm:MainViewModel">

  <!--  DS 6.12: the read command, typed in while a file is read, or the write Save runs while edits are staged; the expanded state is kept  -->
  <ui:CommandPanel Name="Bar"
                   CopyCommand="{Binding CopyCommandCommand}"
                   IsExpanded="{Binding IsCommandExpanded, Mode=TwoWay}"
                   IsTyping="{Binding IsCommandTyping}"
                   IsWrite="{Binding IsCommandWrite}"
                   Tokens="{Binding CommandTokens}" />

</UserControl>
