<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ExifGlass.UI.Controls"
             xmlns:vm="using:ExifGlass.ViewModels"
             x:Class="ExifGlass.Views.InspectorPanel"
             ClipToBounds="False"
             x:DataType="vm:MainViewModel">

  <!--  DS 6.11 / S4: cards 8 apart, AI generation, Selected tag, Frame, Exposure, Details (Add tag comes with P8); the viewer reaches 3 px past the cards so the selected card's ring isn't cut, and to the window's edge so its scroll bar meets it (owner at the P6 review); Avalonia 12 clips a UserControl, so this one doesn't  -->
  <ScrollViewer Name="Scroller"
                Margin="-3,-3,-8,-3"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Name="Cards"
                Margin="3,3,8,3"
                Spacing="8">
      <ui:AiCard Name="AiCard"
                 CopyParametersCommand="{Binding CopyGenerationParametersCommand}"
                 CopyPromptCommand="{Binding CopyPromptCommand}"
                 Info="{Binding AiInfo}"
                 IsVisible="{Binding HasAi}" />
      <ui:SelectedTagCard Name="TagCard"
                          ApplyCommand="{Binding ApplyEditCommand}"
                          CancelCommand="{Binding CancelEditCommand}"
                          CloseCommand="{Binding CloseFocusCommand}"
                          CopyKeyCommand="{Binding CopyFocusKeyCommand}"
                          CopyValueCommand="{Binding CopyFocusValueCommand}"
                          DeleteCommand="{Binding ToggleDeleteCommand}"
                          EditCommand="{Binding StartEditCommand}"
                          EditText="{Binding EditText, Mode=TwoWay}"
                          IsEditing="{Binding IsEditing}"
                          IsVisible="{Binding HasFocusedTag}"
                          RevertCommand="{Binding RevertFocusCommand}"
                          View="{Binding FocusedTag}" />
      <ui:FrameCard Name="FrameCard" Frame="{Binding Frame}" Preview="{Binding Preview}" />
      <ui:ExposureCard Name="ExposureCard" Items="{Binding Exposure}" />
      <ui:DetailsCard Name="DetailsCard" Items="{Binding Details}" OpenLinkCommand="{Binding OpenLinkCommand}" />
    </StackPanel>
  </ScrollViewer>

</UserControl>
