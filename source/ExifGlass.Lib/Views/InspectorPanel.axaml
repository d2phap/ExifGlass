<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ExifGlass.UI.Controls"
             xmlns:vm="using:ExifGlass.ViewModels"
             x:Class="ExifGlass.Views.InspectorPanel"
             ClipToBounds="False"
             x:DataType="vm:MainViewModel">

  <!--  DS 6.11 / S4: cards 8 apart, Add tag while adding, the selected row's card (the AI field's or the tag's; owner at G7, was under the AI card in AI addendum question 4), AI generation or the character card, Preview (DS 6.11's Frame, renamed by the owner at G7), Exposure, Details, each hidden when the file has nothing for it; the viewer reaches 3 px past the cards so the selected card's ring isn't cut, and to the window's edge so its scroll bar meets it (owner at the P6 review); Avalonia 12 clips a UserControl, so this one doesn't  -->
  <ScrollViewer Name="Scroller"
                Margin="-3,-3,-8,-3"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="3,3,8,3">
      <!--  the cards that come and go on top open their room as a panel opens its column, pushing the cards below (owner at G8); each room holds its 8 gap, and a closing card keeps its tag until it is gone (code)  -->
      <ui:CardSlot Name="AddTagSlot"
                   Padding="0,0,0,8"
                   IsOpen="{Binding IsAddingTag}">
        <ui:AddTagCard Name="AddTagCard"
                       AddCommand="{Binding AddTagCommand}"
                       CancelCommand="{Binding CancelAddTagCommand}"
                       Group="{Binding AddGroup, Mode=TwoWay}"
                       Groups="{Binding AddGroups}"
                       Hint="{Binding AddHint}"
                       Suggestions="{Binding AddSuggestions}"
                       TagName="{Binding AddName, Mode=TwoWay}"
                       Value="{Binding AddValue, Mode=TwoWay}" />
      </ui:CardSlot>
      <ui:CardSlot Name="AiFieldSlot"
                   Padding="0,0,0,8"
                   IsOpen="{Binding HasFocusedAiField}">
        <ui:AiFieldCard Name="AiFieldCard"
                        ActionCommand="{Binding AiActionCommand}"
                        CloseCommand="{Binding CloseFocusCommand}" />
      </ui:CardSlot>
      <ui:CardSlot Name="TagSlot"
                   Padding="0,0,0,8"
                   IsOpen="{Binding HasFocusedTag}">
        <ui:SelectedTagCard Name="TagCard"
                            ApplyCommand="{Binding ApplyEditCommand}"
                            CancelCommand="{Binding CancelEditCommand}"
                            CloseCommand="{Binding CloseFocusCommand}"
                            CopyFormatCommand="{Binding CopyFocusFormatCommand}"
                            CopyKeyCommand="{Binding CopyFocusKeyCommand}"
                            CopyRawCommand="{Binding CopyFocusRawCommand}"
                            CopyValueCommand="{Binding CopyFocusValueCommand}"
                            DeleteCommand="{Binding ToggleDeleteCommand}"
                            EditCommand="{Binding StartEditCommand}"
                            EditText="{Binding EditText, Mode=TwoWay}"
                            GoToAiCommand="{Binding JumpToAiCommand}"
                            IsEditing="{Binding IsEditing}"
                            RevertCommand="{Binding RevertFocusCommand}"
                            SaveBinaryCommand="{Binding SaveBinaryCommand}" />
      </ui:CardSlot>
      <StackPanel Name="Cards" Spacing="8">
        <ui:AiCard Name="AiCard"
                   ActionCommand="{Binding AiActionCommand}"
                   ExifToolNote="{Binding ExifToolNote}"
                   Info="{Binding AiInfo}"
                   IsLoading="{Binding IsAiLoading}"
                   IsVisible="{Binding ShowAiCard}" />
        <ui:CharacterCard Name="CharacterCard"
                          ActionCommand="{Binding AiActionCommand}"
                          IsVisible="{Binding HasCharacterCard}"
                          Source="{Binding CharacterSource}" />
        <ui:FrameCard Name="FrameCard"
                      Frame="{Binding Frame}"
                      IsVisible="{Binding ShowPreviewCard}"
                      Preview="{Binding Preview}" />
        <ui:ExposureCard Name="ExposureCard"
                         CopyCommand="{Binding AiActionCommand}"
                         IsVisible="{Binding ShowExposureCard}"
                         Items="{Binding Exposure}" />
        <ui:DetailsCard Name="DetailsCard"
                        CopyCommand="{Binding AiActionCommand}"
                        IsVisible="{Binding ShowDetailsCard}"
                        Items="{Binding Details}"
                        OpenLinkCommand="{Binding OpenLinkCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

</UserControl>
