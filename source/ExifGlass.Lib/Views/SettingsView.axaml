<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ExifGlass.UI.Localization"
             xmlns:app="using:ExifGlass"
             xmlns:tok="using:ExifGlass.UI.Tokens"
             xmlns:ui="using:ExifGlass.UI.Controls"
             xmlns:vm="using:ExifGlass.ViewModels"
             x:Class="ExifGlass.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource BgPanelBrush}">

  <!--  DS 6.15 / Spec 6: General and ExifTool rows on the panel, the command preview, then the footer; rows 56 with a hairline  -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,8,24,20">
        <TextBlock Margin="0,10,0,4"
                   tok:Typography.Role="Overline"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{l:Lang Settings_General}" />

        <Border MinHeight="56"
                Padding="0,8"
                BorderBrush="{DynamicResource EmphasisA07Brush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock tok:Typography.Role="BodyStrong" Text="{l:Lang Settings_AppTheme}" />
              <TextBlock tok:Typography.Role="Meta"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{l:Lang Settings_AppThemeDesc}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ui:SegmentedControl Name="ThemeChoice"
                                 Grid.Column="1"
                                 MinWidth="246"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{l:Lang Settings_AppTheme}"
                                 SelectedIndex="{Binding ThemeIndex}">
              <ui:SegmentedControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ui:SegmentedControl.ItemsPanel>
              <ui:SegmentedItem Content="{l:Lang Settings_ThemeSystem}" Icon="{x:Static ui:IconId.DarkTheme}" />
              <ui:SegmentedItem Content="{l:Lang Settings_ThemeLight}" Icon="{x:Static ui:IconId.WeatherSunny}" />
              <ui:SegmentedItem Content="{l:Lang Settings_ThemeDark}" Icon="{x:Static ui:IconId.WeatherMoon}" />
            </ui:SegmentedControl>
          </Grid>
        </Border>

        <!--  Appendix A item 84: System, then the presets; a choice shows at once, as the theme does  -->
        <Border MinHeight="56"
                Padding="0,8"
                BorderBrush="{DynamicResource EmphasisA07Brush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock tok:Typography.Role="BodyStrong" Text="{l:Lang Settings_AccentColor}" />
              <TextBlock tok:Typography.Role="Meta"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{l:Lang Settings_AccentColorDesc}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ui:SwatchPicker Name="AccentChoice"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="{l:Lang Settings_AccentColor}"
                             ItemsSource="{Binding AccentChoices}"
                             SelectedIndex="{Binding AccentIndex}" />
          </Grid>
        </Border>

        <!--  the language applies with OK, to every open window; the line under it credits the translators  -->
        <Border MinHeight="56"
                Padding="0,8"
                BorderBrush="{DynamicResource EmphasisA07Brush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Center">
              <TextBlock tok:Typography.Role="BodyStrong" Text="{l:Lang Settings_Language}" />
              <TextBlock Name="ContributorsText"
                         tok:Typography.Role="Meta"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         IsVisible="{Binding HasLanguageContributors}"
                         Text="{Binding LanguageContributors}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <ui:GlassButton Name="LanguageMenuButton"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{l:Lang Settings_LanguageMore}"
                              Classes="ghost"
                              Icon="{x:Static ui:IconId.MoreHorizontal}"
                              ToolTip.Tip="{l:Lang Settings_LanguageMore}">
                <ui:GlassButton.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <ui:GlassMenuItem Name="InstallLanguageItem"
                                      Click="InstallLanguageItem_Click"
                                      Glyph="{x:Static ui:IconId.ArrowDownload}"
                                      Header="{l:Lang Settings_LanguageInstall}" />
                    <ui:GlassMenuItem Name="ExportLanguageItem"
                                      Click="ExportLanguageItem_Click"
                                      Glyph="{x:Static ui:IconId.ArrowUpload}"
                                      Header="{l:Lang Settings_LanguageExport}" />
                  </MenuFlyout>
                </ui:GlassButton.Flyout>
              </ui:GlassButton>
              <ComboBox Name="LanguageChoice"
                        Width="246"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{l:Lang Settings_Language}"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageChoice">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                                 IsVisible="{Binding EnglishName, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 Text="{Binding EnglishName}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Grid>
        </Border>

        <Border MinHeight="56"
                Padding="0,8"
                BorderBrush="{DynamicResource EmphasisA07Brush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock tok:Typography.Role="BodyStrong" Text="{l:Lang Settings_AlwaysOnTop}" />
              <TextBlock tok:Typography.Role="Meta"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{l:Lang Settings_AlwaysOnTopDesc}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="OnTopSwitch"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{l:Lang Settings_AlwaysOnTop}"
                          IsChecked="{Binding AlwaysOnTop}" />
          </Grid>
        </Border>

        <Border MinHeight="56"
                Padding="0,8"
                BorderBrush="{DynamicResource EmphasisA07Brush}"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock tok:Typography.Role="BodyStrong" Text="{l:Lang Settings_EnableMultiInstances}" />
              <TextBlock tok:Typography.Role="Meta"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{l:Lang Settings_EnableMultiInstancesDesc}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="MultiInstancesSwitch"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{l:Lang Settings_EnableMultiInstances}"
                          IsChecked="{Binding EnableMultiInstances}" />
          </Grid>
        </Border>

        <Border MinHeight="56"
                Padding="0,8"
                BorderBrush="{DynamicResource EmphasisA07Brush}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding ShowsUpdates}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel VerticalAlignment="Center">
              <TextBlock tok:Typography.Role="BodyStrong" Text="{l:Lang Settings_CheckUpdates}" />
              <TextBlock tok:Typography.Role="Meta"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Text="{l:Lang Settings_CheckUpdatesDesc}"
                         TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Name="UpdatesSwitch"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{l:Lang Settings_CheckUpdates}"
                          IsChecked="{Binding CheckForUpdates}" />
          </Grid>
        </Border>

        <TextBlock Margin="0,18,0,6"
                   tok:Typography.Role="Overline"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{l:Lang Settings_ExifTool}" />

        <StackPanel Margin="0,0,0,14"
                    IsVisible="{Binding ShowsExifToolPath}"
                    Spacing="6">
          <TextBlock tok:Typography.Role="BodyStrong" Text="{l:Lang Settings_ExecutablePath}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="PathBox"
                     AutomationProperties.Name="{l:Lang Settings_ExecutablePath}"
                     FontFamily="{DynamicResource FontMono}"
                     FontSize="{StaticResource FontSizeMono}"
                     PlaceholderText="{Binding ExifToolPlaceholder}"
                     Text="{Binding ExifToolPath}" />
            <ui:GlassButton Name="BrowseButton"
                            Grid.Column="1"
                            Click="BrowseButton_Click"
                            Content="{l:Lang _Browse}"
                            Icon="{x:Static ui:IconId.FolderOpen}"
                            ToolTip.Tip="{l:Lang Settings_BrowseTip}" />
          </Grid>
          <ui:InlineNote Name="PathNote"
                         Icon="{Binding PathHintIcon}"
                         IsVisible="{Binding HasPathHint}"
                         Kind="{Binding PathHintKind}"
                         Text="{Binding PathHint}" />
        </StackPanel>

        <ui:InlineNote Margin="0,0,0,14"
                       Icon="{x:Static ui:IconId.LockClosed}"
                       IsVisible="{Binding ShowsSandboxNote}"
                       Kind="Info"
                       Text="{l:Lang Settings_SandboxNote}" />

        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock VerticalAlignment="Bottom"
                       tok:Typography.Role="BodyStrong"
                       Text="{l:Lang Settings_Arguments}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Bottom"
                       tok:Typography.Role="Meta"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{l:Lang Settings_ArgumentsKeys}" />
          </Grid>
          <ui:TokenField Name="ArgumentField" AutomationProperties.Name="{l:Lang Settings_Arguments}">
            <ui:TokenField.Note>
              <ui:InlineNote Name="ArgumentNote"
                             Icon="{Binding ArgumentHintIcon}"
                             Kind="{Binding ArgumentHintKind}"
                             Text="{Binding ArgumentHint}" />
            </ui:TokenField.Note>
          </ui:TokenField>
        </StackPanel>

        <!--  owner at the P9 review: Copy at the top right, above the command  -->
        <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center"
                     tok:Typography.Role="Overline"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{l:Lang Settings_CommandPreview}" />
          <ui:GlassButton Name="CopyPreviewButton"
                          Grid.Column="1"
                          Margin="0,0,-6,0"
                          AutomationProperties.Name="{l:Lang _CopyCommand}"
                          Classes="ghost small"
                          Command="{Binding CopyCommandLineCommand}"
                          Icon="{x:Static ui:IconId.Copy}"
                          ToolTip.Tip="{l:Lang _CopyCommand}" />
        </Grid>
        <ui:CommandPreview Name="Preview" Tokens="{Binding PreviewTokens}" />
      </StackPanel>
    </ScrollViewer>

    <!--  Proto: 64 high, a hairline above, Emphasis 2.5%; Reset alone on the left, OK then Cancel on the right (owner's footer order, Appendix A item 73)  -->
    <Border Grid.Row="1"
            Height="64"
            Padding="24,0"
            Background="{DynamicResource EmphasisA03Brush}"
            BorderBrush="{DynamicResource EmphasisA07Brush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <ui:GlassButton Name="ResetButton"
                        Classes="ghost"
                        Command="{Binding ResetCommand}"
                        Content="{l:Lang _Reset}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Icon="{x:Static ui:IconId.ArrowReset}"
                        ToolTip.Tip="{l:Lang Settings_ResetTip}" />
        <ui:GlassButton Name="OkButton"
                        Grid.Column="2"
                        MinWidth="80"
                        Classes="primary"
                        Command="{Binding OkCommand}"
                        Content="{l:Lang _Ok}" />
        <ui:GlassButton Name="CancelButton"
                        Grid.Column="3"
                        MinWidth="80"
                        Command="{Binding CancelCommand}"
                        Content="{l:Lang _Cancel}" />
      </Grid>
    </Border>

    <ui:ToastHost Name="Toasts" Grid.RowSpan="2" />
  </Grid>

</UserControl>
