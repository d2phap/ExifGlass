<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ExifGlass.UI.Controls"
        xmlns:v="using:ExifGlass.Views"
        xmlns:vm="using:ExifGlass.ViewModels"
        x:Class="ExifGlass.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        MinWidth="420"
        MinHeight="480"
        DragDrop.AllowDrop="True"
        Topmost="{Binding IsPinned}">

  <ui:DialogHost Name="Dialogs">
    <Panel>
      <DockPanel>
        <v:AppToolbar Name="Toolbar" DockPanel.Dock="Top" />

        <!--  DS 2 layout grid: padding 8 (none on top), gap 8; rail 236 in a 244 column, inspector 304 in a 312 column, the command bar spans all  -->
        <ui:OverlayHost Name="Overlays"
                        IsLeftOpen="{Binding IsRailOverlayOpen, Mode=TwoWay}"
                        IsRightOpen="{Binding IsInspectorOverlayOpen, Mode=TwoWay}">
          <ui:OverlayHost.LeftPane>
            <ui:SquircleBorder Name="RailOverlayFrame"
                               Width="{StaticResource RailWidth}"
                               Margin="8,0,0,56"
                               Padding="8"
                               Background="{DynamicResource BgPanelBrush}"
                               BorderBrush="{DynamicResource EmphasisA10Brush}"
                               BorderThickness="1"
                               BoxShadow="{StaticResource ElevationOverlay}"
                               CornerRadius="{StaticResource RadiusPanel}" />
          </ui:OverlayHost.LeftPane>
          <ui:OverlayHost.RightPane>
            <ui:SquircleBorder Name="InspectorOverlayFrame"
                               Width="{StaticResource InspectorWidth}"
                               Margin="0,0,8,56"
                               Padding="8"
                               Background="{DynamicResource BgWindowBrush}"
                               BorderBrush="{DynamicResource EmphasisA10Brush}"
                               BorderThickness="1"
                               BoxShadow="{StaticResource ElevationOverlay}"
                               CornerRadius="{StaticResource RadiusPanel}" />
          </ui:OverlayHost.RightPane>

          <Grid Name="LayoutGrid"
                Margin="8,0,8,8"
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="*,8,Auto">
            <ui:DockSlot Name="RailSlot"
                         Anchor="Left"
                         IsOpen="{Binding IsRailDocked}"
                         OpenWidth="{StaticResource RailColumn}">
              <Panel>
                <ui:SquircleBorder Name="RailDockFrame"
                                   Width="{StaticResource RailWidth}"
                                   HorizontalAlignment="Left"
                                   Padding="8"
                                   Background="{DynamicResource BgPanelBrush}"
                                   BorderBrush="{DynamicResource StrokeHairlineBrush}"
                                   BorderThickness="1"
                                   CornerRadius="{StaticResource RadiusPanel}">
                  <!--  P6 fills the rail  -->
                  <Panel Name="RailContent" />
                </ui:SquircleBorder>
              </Panel>
            </ui:DockSlot>

            <v:TablePanel Name="Table" Grid.Column="1" />

            <ui:DockSlot Name="InspectorSlot"
                         Grid.Column="2"
                         Anchor="Right"
                         IsOpen="{Binding IsInspectorDocked}"
                         OpenWidth="{StaticResource InspectorColumn}">
              <Panel>
                <ui:SquircleBorder Name="InspectorDockFrame"
                                   Width="{StaticResource InspectorWidth}"
                                   HorizontalAlignment="Right">
                  <!--  P6 fills the inspector  -->
                  <Panel Name="InspectorContent" />
                </ui:SquircleBorder>
              </Panel>
            </ui:DockSlot>

            <v:CommandBar Name="CommandBarView"
                          Grid.Row="2"
                          Grid.ColumnSpan="3" />
          </Grid>
        </ui:OverlayHost>
      </DockPanel>

      <v:DropScrim Name="Scrim" />
      <ui:ToastHost Name="Toasts" />
    </Panel>
  </ui:DialogHost>

</Window>
