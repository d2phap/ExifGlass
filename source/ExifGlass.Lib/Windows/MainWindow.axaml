<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ExifGlass.UI.Controls"
        xmlns:v="using:ExifGlass.Views"
        xmlns:vm="using:ExifGlass.ViewModels"
        x:Class="ExifGlass.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        MinWidth="320"
        MinHeight="240"
        DragDrop.AllowDrop="True"
        Topmost="{Binding IsPinned}">

  <ui:DialogHost Name="Dialogs">
    <Panel>
      <DockPanel>
        <v:AppToolbar Name="Toolbar" DockPanel.Dock="Top" />

        <!--  DS 2 layout grid: padding 8 (none on top), gap 8; rail 236 in a 244 column, inspector 304 in a 312 column, the command bar spans all  -->
        <Grid Name="LayoutGrid"
              Margin="8,0,8,8"
              RowDefinitions="*,8,Auto">
          <!--  below the docking widths a panel pushes the table aside instead (owner at G4 review)  -->
          <ui:PushHost Name="Pushes"
                       IsLeftOpen="{Binding IsRailPushed, Mode=TwoWay}"
                       IsRightOpen="{Binding IsInspectorPushed, Mode=TwoWay}"
                       LeftTravel="{StaticResource RailColumn}"
                       RightTravel="{StaticResource InspectorColumn}">
            <ui:PushHost.LeftPane>
              <!--  the rail's padding is its scroll content's, so the scroll bar meets the panel's edge (owner at the P6 review)  -->
              <ui:SquircleBorder Name="RailPushFrame"
                                 Width="{StaticResource RailWidth}"
                                 ClipToBounds="True"
                                 Background="{DynamicResource BgPanelBrush}"
                                 BorderBrush="{DynamicResource StrokeHairlineBrush}"
                                 BorderThickness="1"
                                 CornerRadius="{StaticResource RadiusPanel}" />
            </ui:PushHost.LeftPane>
            <ui:PushHost.RightPane>
              <ui:SquircleBorder Name="InspectorPushFrame" Width="{StaticResource InspectorWidth}" />
            </ui:PushHost.RightPane>

            <Grid ColumnDefinitions="Auto,*,Auto">
              <ui:DockSlot Name="RailSlot"
                           Anchor="Right"
                           IsOpen="{Binding IsRailDocked}"
                           OpenWidth="{StaticResource RailColumn}">
                <Panel>
                  <ui:SquircleBorder Name="RailDockFrame"
                                     Width="{StaticResource RailWidth}"
                                     HorizontalAlignment="Left"
                                     ClipToBounds="True"
                                     Background="{DynamicResource BgPanelBrush}"
                                     BorderBrush="{DynamicResource StrokeHairlineBrush}"
                                     BorderThickness="1"
                                     CornerRadius="{StaticResource RadiusPanel}">
                    <!--  P6 fills the rail  -->
                    <Panel Name="RailContent" />
                  </ui:SquircleBorder>
                </Panel>
              </ui:DockSlot>

              <v:TablePanel Name="Table" Grid.Column="1" />

              <ui:DockSlot Name="InspectorSlot"
                           Grid.Column="2"
                           Anchor="Left"
                           IsOpen="{Binding IsInspectorDocked}"
                           OpenWidth="{StaticResource InspectorColumn}">
                <Panel>
                  <ui:SquircleBorder Name="InspectorDockFrame"
                                     Width="{StaticResource InspectorWidth}"
                                     HorizontalAlignment="Right">
                    <!--  P6 fills the inspector  -->
                    <Panel Name="InspectorContent" />
                  </ui:SquircleBorder>
                </Panel>
              </ui:DockSlot>
            </Grid>
          </ui:PushHost>

          <v:CommandBar Name="CommandBarView" Grid.Row="2" />
        </Grid>
      </DockPanel>

      <v:DropScrim Name="Scrim" />
      <ui:ToastHost Name="Toasts" />
    </Panel>
  </ui:DialogHost>

</Window>
