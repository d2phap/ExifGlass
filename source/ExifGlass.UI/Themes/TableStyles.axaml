<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tok="using:ExifGlass.UI.Tokens"
        xmlns:ui="using:ExifGlass.UI.Controls"
        x:Class="ExifGlass.UI.Themes.TableStyles">

  <!--  the table's cell and overlay styles, held by MetadataTable: as app styles, every TextBlock, Border, button and icon in the window paid for them (G6 finding 2)  -->

  <!--  cell content made by the recycling factories (Proto): # mono 11 tertiary, Tag ID mono 11.5 secondary (AI fields in Accent2), name secondary, value primary with tabular figures; selected by type, so the table's other text pays nothing for them (the Tag ID and name cells style as TextBlock and take their brushes in code)  -->
  <Style Selector="ui|IndexCell">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="ui|ValueCell > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="ui|ValueCell.edited > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="ui|ValueCell.deleted > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>

  <!--  the staged-edit badge after a value (Proto): 18 high, radius 8, 6 px from the text  -->
  <Style Selector="ui|Badge.table-badge">
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl18}" />
  </Style>

  <!--  the copy button: hidden until its row is hovered or selected, then 140 ms; green while it shows the check  -->
  <Style Selector="ui|GlassButton.table-copy">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Easing="{x:Static tok:MotionTokens.CopyButtonEasing}" Property="Opacity" Duration="0:0:0.14" />
        <BrushTransition Easing="{x:Static tok:MotionTokens.HoverEasing}" Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="DataGridRow:pointerover ui|GlassButton.table-copy, DataGridRow.selected ui|GlassButton.table-copy, ui|GlassButton.table-copy.copied">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ui|GlassButton.table-copy:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ui|GlassButton.table-copy.copied">
    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
  </Style>

  <!--  the current cell's ring (DS 6.9): 1.5 px accent inset, Accent 8%, radius 10; on a group header, the 2 px focus ring  -->
  <Style Selector="Border.table-ring">
    <Setter Property="Background" Value="{DynamicResource AccentA08Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCell}" />
  </Style>
  <Style Selector="Border.table-ring.header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!--  skeleton rows (Proto): Emphasis 5, 6, 8 and 10% across the columns; the hairline between rows is SkeletonRows' own  -->
  <Style Selector="ui|Skeleton.table-skeleton.index">
    <Setter Property="Background" Value="{DynamicResource EmphasisA05Brush}" />
  </Style>
  <Style Selector="ui|Skeleton.table-skeleton.id">
    <Setter Property="Background" Value="{DynamicResource EmphasisA06Brush}" />
  </Style>
  <Style Selector="ui|Skeleton.table-skeleton.name">
    <Setter Property="Background" Value="{DynamicResource EmphasisA08Brush}" />
  </Style>
  <Style Selector="ui|Skeleton.table-skeleton.value">
    <Setter Property="Background" Value="{DynamicResource EmphasisA10Brush}" />
  </Style>

</Styles>
