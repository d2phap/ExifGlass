  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space10">10</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space14">14</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space20">20</x:Double>
  <x:Double x:Key="Space24">24</x:Double>

  <!--  Sizes (DS 6)  -->
  <x:Double x:Key="ControlHeight">32</x:Double>
  <x:Double x:Key="ControlHeightCard">30</x:Double>
  <x:Double x:Key="ControlHeightSmall">28</x:Double>
  <x:Double x:Key="ControlHeightTiny">24</x:Double>
  <x:Double x:Key="AppToolbarHeight">48</x:Double>
  <x:Double x:Key="TableToolbarHeight">50</x:Double>
  <x:Double x:Key="CommandBarHeight">40</x:Double>
  <x:Double x:Key="MenuItemHeight">34</x:Double>
  <x:Double x:Key="MenuItemTallHeight">44</x:Double>
  <x:Double x:Key="ToastHeight">44</x:Double>
  <x:Double x:Key="ToastBottomOffset">62</x:Double>
  <x:Double x:Key="StoreBadgeHeight">52</x:Double>
  <x:Double x:Key="RailWidth">200</x:Double>
  <x:Double x:Key="RailColumn">208</x:Double>
  <x:Double x:Key="InspectorWidth">304</x:Double>
  <x:Double x:Key="InspectorColumn">312</x:Double>
  <x:Double x:Key="IconToolbar">18</x:Double>
  <x:Double x:Key="IconButton">16</x:Double>
  <x:Double x:Key="IconChip">14</x:Double>
  <x:Double x:Key="IconSmall">12</x:Double>

  <!--  Elevation (DS 1.5): CSS blur converted to Avalonia's  -->
  <BoxShadows x:Key="Elevation1">0 18 84.87 -12 #59000000</BoxShadows>
  <BoxShadows x:Key="Elevation2">0 32 136.83 -20 #80000000</BoxShadows>
  <BoxShadows x:Key="ElevationToast">0 18 74.48 -14 #66000000</BoxShadows>
  <BoxShadows x:Key="ShadowSegmentedThumb">0 1 3.46 0 #29000000</BoxShadows>
  <BoxShadows x:Key="ShadowSelectedCard">0 0 0 3 #14225EDB</BoxShadows>
  <BoxShadows x:Key="ShadowSelectedAiCard">0 0 0 3 #14BF3298</BoxShadows>
  <BoxShadows x:Key="ShadowFocusPoint">0 0 0 4 #1F225EDB</BoxShadows>
  <BoxShadows x:Key="ShadowTooltip">0 8 32.91 -6 #40000000</BoxShadows>

  <!--  Font sizes (DS 1.1); mono +1 off Windows cancels the -1 pt coercion (S3)  -->
  <x:Double x:Key="FontSizeDisplay">22</x:Double>
  <x:Double x:Key="FontSizeTitle">16</x:Double>
  <x:Double x:Key="FontSizeSubtitle">14</x:Double>
  <x:Double x:Key="FontSizeEmptyTitle">17</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeControl">12.5</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeMeta">11.5</x:Double>
  <x:Double x:Key="FontSizeOverline">11</x:Double>
  <x:Double x:Key="FontSizeBadge">10.5</x:Double>
  <x:Double x:Key="FontSizeStoreTitle">16</x:Double>
  <OnPlatform x:Key="FontSizeMono" x:TypeArguments="x:Double" Default="12.5" Windows="11.5" />
  <OnPlatform x:Key="FontSizeMonoValue" x:TypeArguments="x:Double" Default="13.5" Windows="12.5" />
  <OnPlatform x:Key="FontSizeMonoSmall" x:TypeArguments="x:Double" Default="12" Windows="11" />
  <OnPlatform x:Key="FontSizeMonoBadge" x:TypeArguments="x:Double" Default="11.5" Windows="10.5" />

  <!--  Fonts: one family name on Windows (a fallback list switches non-400 weights to static Segoe UI); AppFonts picks the system mono  -->
  <OnPlatform x:Key="FontUi" x:TypeArguments="FontFamily" Default="fonts:Inter#Inter" Windows="Segoe UI Variable Text" />
  <OnPlatform x:Key="FontMono" x:TypeArguments="FontFamily" Default="DejaVu Sans Mono" Windows="Cascadia Mono" macOS="Menlo" />

</ResourceDictionary>
