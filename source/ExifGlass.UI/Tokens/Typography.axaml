<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  generated by source/tools/gen-tokens.cs from DS 1.1; do not edit. LineHeight only on text that may wrap: single-line labels keep the natural height, centred (S3)  -->

  <!--  display: 22 SemiBold, About app name  -->
  <Style Selector=":is(TextBlock).display">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!--  readout: 22 Medium, Exposure readouts  -->
  <Style Selector=":is(TextBlock).readout">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!--  title: 16/22 SemiBold, Selected-tag name, section titles  -->
  <Style Selector=":is(TextBlock).title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="22" />
  </Style>

  <!--  subtitle: 14/20 Medium, Table toolbar summary  -->
  <Style Selector=":is(TextBlock).subtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <!--  empty-title: 17 Medium, Empty-state title (plan Appendix A item 23)  -->
  <Style Selector=":is(TextBlock).empty-title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!--  body: 13/19 Normal, Default text, table cells  -->
  <Style Selector=":is(TextBlock).body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="19" />
  </Style>

  <!--  body-strong: 13/19 Medium, Menu labels, group names  -->
  <Style Selector=":is(TextBlock).body-strong">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="19" />
  </Style>

  <!--  control: 12.5 Medium, Button labels, segmented options  -->
  <Style Selector=":is(TextBlock).control">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!--  caption: 12/16 Normal, Field descriptions, helper text  -->
  <Style Selector=":is(TextBlock).caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <!--  meta: 11.5/16 Normal, Secondary meta, sub-labels, chip text  -->
  <Style Selector=":is(TextBlock).meta">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <!--  overline: 11 Medium, UPPERCASE section labels  -->
  <Style Selector=":is(TextBlock).overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.66" />
  </Style>

  <!--  badge: 10.5 Medium, Status badges  -->
  <Style Selector=":is(TextBlock).badge">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!--  mono: 11.5 Normal mono, Tag IDs, command tokens  -->
  <Style Selector=":is(TextBlock).mono">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize">
      <OnPlatform x:TypeArguments="x:Double" Default="12.5" Windows="11.5" />
    </Setter>
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!--  mono-value: 12.5/19 Normal mono, Inspector value well  -->
  <Style Selector=":is(TextBlock).mono-value">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize">
      <OnPlatform x:TypeArguments="x:Double" Default="13.5" Windows="12.5" />
    </Setter>
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!--  mono-small: 11 Normal mono, Tag ID in the selected-tag card  -->
  <Style Selector=":is(TextBlock).mono-small">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize">
      <OnPlatform x:TypeArguments="x:Double" Default="12" Windows="11" />
    </Setter>
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!--  mono-badge: 10.5 Medium mono, Count badges, kbd hints  -->
  <Style Selector=":is(TextBlock).mono-badge">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize">
      <OnPlatform x:TypeArguments="x:Double" Default="11.5" Windows="10.5" />
    </Setter>
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

</Styles>
