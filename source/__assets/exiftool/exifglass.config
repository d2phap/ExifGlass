#------------------------------------------------------------------------------
# Pass with -config as the first argument: a -stay_open daemon reads it only at start
#------------------------------------------------------------------------------

%Image::ExifTool::UserDefined = (
    # same names ExifTool shows without this file; defined so they can be written and deleted
    'Image::ExifTool::PNG::TextualData' => {
        prompt              => { },  # ComfyUI API graph, Easy Diffusion prompt
        workflow            => { },  # ComfyUI UI graph
        invokeai_metadata   => { },
        invokeai_workflow   => { },
        invokeai_graph      => { },
        'sd-metadata'       => { Name => 'Sd-metadata' },
        Dream               => { },
        fooocus_scheme      => { },
        negative_prompt     => { },
        'Generation time'   => { Name => 'GenerationTime' },
        AIGC                => { },  # GB 45438-2025 implicit label (JSON)
        generation_data     => { },  # Tensor.art
        # Easy Diffusion writes one chunk per field; defined so "Remove AI generation data" can delete them
        seed                        => { },
        use_stable_diffusion_model  => { },
        sampler_name                => { },
        num_inference_steps         => { },
        guidance_scale              => { },
        width                       => { },
        height                      => { },
        use_vae_model               => { },
        clip_skip                   => { },
        use_lora_model              => { },
        lora_alpha                  => { },
        use_hypernetwork_model      => { },
        hypernetwork_strength       => { },
        prompt_strength             => { },
        use_upscale                 => { },
        use_face_correction         => { },
    },
    'Image::ExifTool::PNG::Main' => {
        # ComfyUI animated PNG: key and JSON like tEXt; a binary tag shows only a placeholder in -j
        comf => {
            Name => 'ComfyUIData',
            SubDirectory => { TagTable => 'Image::ExifTool::PNG::TextualData' },
        },
    },
    'Image::ExifTool::QuickTime::Keys' => {
        prompt   => { },
        workflow => { },
        AIGC     => { },
    },
);

# Ends an orphaned -stay_open ExifTool, which polls forever after EOF (S6, R11); Windows uses a job object
if ($^O ne 'MSWin32') {
    require POSIX;
    my $parent = getppid();
    my $check = sub {
        exit 0 if getppid() != $parent;
        alarm 1;
    };
    # SA_RESTART: a plain $SIG{ALRM} would break the idle read of stdin with EINTR and end -stay_open
    POSIX::sigaction(POSIX::SIGALRM(), POSIX::SigAction->new($check, POSIX::SigSet->new(), POSIX::SA_RESTART()))
        or warn "exifglass.config: sigaction failed: $!\n";
    alarm 1;
}

1;  #end
