<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store only (D7, S7); pack-mac-pkg-appstore.sh adds the application and team identifiers from the provisioning profile -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- the file the user opens or drops, read for the container copy and written over in place after a save -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
